# Copy to .env and fill in real values. Never commit .env itself.

# Gemini / ADK agents
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GCP_PROJECT=
GCP_LOCATION=

# GitHub — PR Agent, "pos" target (default): pushes POS GMO retail-platform
# modules into the existing product repos.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BACKEND_REPO_NAME=

# GitHub — PR Agent, "commercial" target (--target commercial): where Factory
# AI GMO's own commercial-platform modules (organization, projects,
# pricingPlan, factoryRun, factoryAccount, ...) get pushed. Decision
# (2026-09-21): NOT a separate repo — same repos as the "pos" target above.
# The env vars exist as their own names, not aliased to GITHUB_REPO_NAME
# directly, so this stays a one-line change here if that decision changes
# later, without touching orchestrator.py/agents/prd_parser/rules.py again.
GITHUB_COMMERCIAL_FRONTEND_REPO=
GITHUB_COMMERCIAL_BACKEND_REPO=

# Live SQL Server — Schema Analyst / Database Executor agents
LOCAL_DB_SERVER=
LOCAL_DB_NAME=
LOCAL_DB_USER=
LOCAL_DB_PASSWORD=

# Azure Face API
AZURE_FACE_API_ENDPOINT=
AZURE_FACE_API_KEY=
AZURE_FACE_API_LOCATION=

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL_FALLBACK=
CLIENTS_CONTAINER_NAME=
TICKETS_CONTAINER_NAME=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# MCP knowledge server
MCP_TRANSPORT=
MCP_HTTP_PORT=
