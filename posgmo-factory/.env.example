# Copy to .env and fill in values

# GitHub — used by PRAgent to create branches and pull requests
GITHUB_TOKEN=ghp_...
GITHUB_REPO_OWNER=montanogilberto
GITHUB_REPO_NAME=checkInPOS        # frontend repo
GITHUB_BACKEND_REPO_NAME=smartloans # backend repo

# ADK model (override per-agent if needed)
GOOGLE_API_KEY=...
# OR for Anthropic backend:
ANTHROPIC_API_KEY=sk-ant-...

# MCP server transport (stdio | http)
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8100
